{
  // Decra on Cloudflare Workers (via OpenNext). One worker serves the admin
  // and all three property domains; the middleware picks the site by host.
  // Deploy: `npm run cf:deploy` (or Cloudflare Workers Builds from GitHub).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decra",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // OpenNext's cache revalidation calls back into this same worker
    { "binding": "WORKER_SELF_REFERENCE", "service": "decra" }
  ],
  // Run near the data (Supabase, Lodgify) rather than near each visitor
  "placement": { "mode": "smart" },
  // Formerly vercel.json crons (UTC). worker.ts maps each to its route.
  "triggers": {
    "crons": ["0 19 * * *", "15 19 * * *", "30 19 * * *", "0 20 * * *", "0 21 * * *"]
  },
  "observability": { "enabled": true }
}
