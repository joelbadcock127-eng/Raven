;; anniemay.com.au: DNS records to hold in Vercel DNS (nameservers ns1/ns2.vercel-dns.com).
;; Website records (root and www) are NOT here: Vercel creates them itself
;; once the domain is added to the Decra project. Everything below is email
;; and verification, copied from the old agency's DNS (checked 22 Oct 2026).
;; Import: vercel dns import anniemay.com.au docs/dns/zones/anniemay.com.au.zone  (or add by hand, see docs/dns-cutover.md)
;; ADDED: _dmarc (monitoring only; Gmail/Yahoo expect one from MailerLite senders).
;; Email is Microsoft 365 — MX/SPF/autodiscover preserved exactly; no email migration needed.
autodiscover.anniemay.com.au.	3600	IN	CNAME	autodiscover.outlook.com.
em944325.anniemay.com.au.	3600	IN	CNAME	return.smtp2go.net.
link.anniemay.com.au.	3600	IN	CNAME	track.smtp2go.net.
litesrv._domainkey.anniemay.com.au.	3600	IN	CNAME	litesrv._domainkey.mlsend.com.
s944325._domainkey.anniemay.com.au.	3600	IN	CNAME	dkim.smtp2go.net.
anniemay.com.au.	3600	IN	MX	0 anniemay-com-au.mail.protection.outlook.com.
anniemay.com.au.	3600	IN	TXT	"mailerlite-domain-verification=d2f207c538a1e4ad88745de4dc20f2909d44a862"
anniemay.com.au.	3600	IN	TXT	"v=spf1 include:_spf.mlsend.com include:spf.protection.outlook.com -all"
anniemay.com.au.	3600	IN	TXT	"mscid=Su9g3Kw3MwbA/DPq68OpD49HiMOcQqcHGWCkyIMhdpxMYMBvkQHMrs27i2a4Ci778LtL7hiKCcChOQqjeWNqjA=="
_dmarc.anniemay.com.au.	3600	IN	TXT	"v=DMARC1; p=none;"
