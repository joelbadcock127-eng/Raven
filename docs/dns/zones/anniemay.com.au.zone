;; anniemay.com.au: import into Cloudflare (DNS → Records → Import and Export → Import).
;; UNTICK "Proxy imported DNS records": every record here must be DNS only.
;; Website records (root and www) are NOT here: adding the domain as a Custom
;; Domain on the decra-sites worker creates them.
;; Email: Microsoft 365, records preserved from the old DNS. No MailerLite.
anniemay.com.au.	3600	IN	MX	0 anniemay-com-au.mail.protection.outlook.com.
autodiscover.anniemay.com.au.	3600	IN	CNAME	autodiscover.outlook.com. ; cf_tags=cf-proxied:false
anniemay.com.au.	3600	IN	TXT	"v=spf1 include:spf.protection.outlook.com -all"
anniemay.com.au.	3600	IN	TXT	"mscid=Su9g3Kw3MwbA/DPq68OpD49HiMOcQqcHGWCkyIMhdpxMYMBvkQHMrs27i2a4Ci778LtL7hiKCcChOQqjeWNqjA=="
_dmarc.anniemay.com.au.	3600	IN	TXT	"v=DMARC1; p=none;"
